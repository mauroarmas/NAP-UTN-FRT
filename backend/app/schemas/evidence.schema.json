{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nap.invalid/schemas/evidence.v1.json",
  "title": "Evidencia institucional habilitante v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tipo",
    "entorno",
    "operador_institucional",
    "referencia_institucional",
    "observado_at",
    "resultado"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tipo": {
      "enum": [
        "acceso_instancia",
        "validacion_definicion",
        "revocacion_consola"
      ]
    },
    "entorno": {
      "enum": [
        "real",
        "simulado"
      ]
    },
    "operador_institucional": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "referencia_institucional": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "observado_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "resultado": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "acceso_instancia"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "properties": {
          "resultado": {
            "$ref": "#/$defs/acceso_instancia"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "validacion_definicion"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "properties": {
          "resultado": {
            "$ref": "#/$defs/validacion_definicion"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "revocacion_consola"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "properties": {
          "resultado": {
            "$ref": "#/$defs/revocacion_consola"
          }
        }
      }
    }
  ],
  "$defs": {
    "acceso_instancia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "servicio_id",
        "definicion_id",
        "resource_uuid",
        "nonce_sha256",
        "preparacion_id",
        "endpoint",
        "equipo_origen",
        "red_origen",
        "metodo",
        "pruebas"
      ],
      "properties": {
        "servicio_id": {
          "type": "integer",
          "minimum": 1
        },
        "definicion_id": {
          "type": "string",
          "format": "uuid"
        },
        "resource_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "nonce_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preparacion_id": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "equipo_origen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "red_origen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metodo": {
          "const": "manual"
        },
        "pruebas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          }
        }
      }
    },
    "validacion_definicion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definicion_id",
        "definition_key",
        "definition_version",
        "image_sha256",
        "recipe_sha256",
        "cluster_uuid",
        "pve_versions",
        "instancias",
        "checks"
      ],
      "properties": {
        "definicion_id": {
          "type": "string",
          "format": "uuid"
        },
        "definition_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "definition_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "recipe_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cluster_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "pve_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "instancias": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,79}$"
          }
        }
      }
    },
    "revocacion_consola": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cambio_consola_id",
        "revision_esperada",
        "identidad_nativa",
        "scopes_resultantes",
        "sesiones_previas_terminadas",
        "url_directa_denegada",
        "otros_accesos_legitimos_comprobados"
      ],
      "properties": {
        "cambio_consola_id": {
          "type": "string",
          "format": "uuid"
        },
        "revision_esperada": {
          "type": "integer",
          "minimum": 1
        },
        "identidad_nativa": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scopes_resultantes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/pool/[A-Za-z0-9._-]{1,100}$"
          }
        },
        "sesiones_previas_terminadas": {
          "const": true
        },
        "url_directa_denegada": {
          "const": true
        },
        "otros_accesos_legitimos_comprobados": {
          "const": true
        },
        "cluster_uuid": {
          "type": "string",
          "format": "uuid"
        },
        "pve_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
