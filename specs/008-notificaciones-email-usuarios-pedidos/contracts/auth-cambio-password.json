{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth API - Primer Cambio de Contraseña",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/cambiar-password-inicial": {
      "post": {
        "summary": "Establece la contraseña definitiva en el primer ingreso",
        "description": "Permite al usuario autenticado con contraseña provisoria fijar su nueva contraseña y desbloquear su cuenta.",
        "security": [
          { "OAuth2PasswordBearer": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CambiarPasswordInicialRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada con éxito y flag desactivado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error de validación (longitud menor a 8 caracteres o campos vacíos)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token inválido o expirado"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CambiarPasswordInicialRequest": {
        "type": "object",
        "required": ["nueva_password"],
        "properties": {
          "nueva_password": {
            "type": "string",
            "minLength": 8,
            "description": "Nueva contraseña definitiva elegida por el usuario"
          }
        }
      },
      "UsuarioResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string", "nullable": true },
          "nombre": { "type": "string" },
          "rol": { "type": "string" },
          "activo": { "type": "boolean" },
          "debe_cambiar_password": { "type": "boolean" },
          "recibir_notificaciones_email": { "type": "boolean" },
          "totp_habilitado": { "type": "boolean" },
          "catedras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "integer" },
                "nombre": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}

