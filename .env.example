# Desarrollo local. Generar .env con: python3 scripts/traspaso.py init
# No copiar el .env de Mauro: incluye configuración exclusiva de su PC.
APP_ENV=development
APP_DEBUG=false
APP_FRONTEND_URL=http://localhost:5174
# URL para herramientas Python ejecutadas en el HOST. Compose usa db:5432.
DATABASE_URL=postgresql+asyncpg://ps_user:ps_password@127.0.0.1:5434/ps_db
SECRET_KEY=GENERAR_SECRET_KEY
CSRF_SECRET=GENERAR_CSRF_SECRET
SECRET_KEYRING='GENERAR_SECRET_KEYRING'
SECRET_ACTIVE_KEY=local-v1
AUTH_ALLOWED_ORIGINS=[]
TRUSTED_PROXY_NETWORKS=[]
INSTITUTIONAL_TIMEZONE=America/Argentina/Tucuman

# Sin conexión a infraestructura hasta configurarla expresamente.
PROXMOX_HOST=127.0.0.1
PROXMOX_PORT=8006
PROXMOX_USER=nap@pve
PROXMOX_TOKEN_NAME=pendiente
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@nap.test
SMTP_TLS=false
SMTP_SSL=false

# No definir COMPOSE_FILE ni NAP_SETTINGS_FILE con rutas de otra computadora.
# Clon aislado: docker compose -p nap-handoff -f docker-compose.handoff.yml ...
# Ver docs/traspaso-011.md para la DB, keyring y configuración real de Proxmox.
